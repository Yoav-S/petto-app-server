rules_version = '2';

// Craft rules based on the specific instructions for the app.
service firebase.storage {
  match /b/{bucket}/o {
    
    // Pets avatars / images
    // Path structure: users/{userId}/pets/{imageId}
    match /users/{userId}/{allPaths=**} {

      // Public read so expo-image can load https download URLs without
      // attaching a Firebase ID token. Paths are unguessable (uid + timestamp).
      // Writes stay owner-only below.
      allow read: if true;

      // Write: owner only, images up to 5MB.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Business listing photos. The API uploads these with the Admin SDK
    // to businesses/{businessId}/. Browsers only need to read them.
    match /businesses/{businessId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny for everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
