# =============================================================================
# LOCAL / DEVELOPMENT — copy to .env and fill in values
#   cp .env.example .env
# Cloud Run production values: see .env.production.example (set in Cloud Run UI)
# =============================================================================

APP_ENV=development
PORT=8080

# Use a separate DB name so local experiments never touch production data.
MONGODB_URI=
MONGODB_DB_NAME=petto_dev

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM with literal \n between lines, OR use FIREBASE_PRIVATE_KEY_BASE64
FIREBASE_PRIVATE_KEY=
# FIREBASE_PRIVATE_KEY_BASE64=
# FIREBASE_STORAGE_BUCKET=

# Local Expo / Metro
CLIENT_APP_URL=http://localhost:8081
DEEP_LINK_SCHEME=petto-dev
DEEP_LINK_DOMAIN=localhost:8081

# Email OTP — Resend (or leave empty to log OTP in development)
RESEND_API_KEY=
RESEND_FROM_EMAIL=peto <noreply@peto.casa>

# Push / reminder dispatcher (optional locally)
EXPO_ACCESS_TOKEN=
INTERNAL_TASK_SECRET=
DEFAULT_TIMEZONE=UTC

# RevenueCat webhook (optional until you test webhooks locally)
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# Google Play review account (fixed OTP). Empty email disables.
PLAY_REVIEW_EMAIL=play.review@peto.casa
PLAY_REVIEW_OTP=482917
