# =============================================================================
# PRODUCTION — do NOT copy secrets into git.
# Set these on Cloud Run → petto-server → Edit & deploy → Variables & secrets
# (or Secret Manager). This file is a checklist only.
# =============================================================================

APP_ENV=production
PORT=8080

# Same Atlas cluster is fine; keep production data in this DB name.
MONGODB_URI=<from Secret Manager / Cloud Run secret>
MONGODB_DB_NAME=petto

FIREBASE_PROJECT_ID=petto-494013
FIREBASE_CLIENT_EMAIL=<service account email>
FIREBASE_PRIVATE_KEY_BASE64=<recommended on Cloud Run>
# or FIREBASE_PRIVATE_KEY=<pem with \n>

CLIENT_APP_URL=https://peto.casa
DEEP_LINK_SCHEME=petto
DEEP_LINK_DOMAIN=peto.casa

RESEND_API_KEY=<secret>
RESEND_FROM_EMAIL=peto <noreply@peto.casa>

INTERNAL_TASK_SECRET=<same value Cloud Scheduler sends as X-Internal-Secret>
DEFAULT_TIMEZONE=UTC
# EXPO_ACCESS_TOKEN=  # only if Expo enhanced push security is on

REVENUECAT_WEBHOOK_SECRET=<match RevenueCat dashboard webhook>
# REVENUECAT_API_KEY=

PLAY_REVIEW_EMAIL=play.review@peto.casa
PLAY_REVIEW_OTP=482917
